{
  "id": "segments.preview_matching_contacts",
  "name": "Preview contacts matching a filter",
  "category": "segments",
  "area": "web-app-internal",
  "description": "Return a page of the contacts that match a filter, without saving a segment.",
  "inputs": {
    "type": "object",
    "properties": {
      "fe_query": {
        "type": "object",
        "description": "Filter tree. An 'or' list of groups; each group has an 'and' list of conditions. A condition is {contact: {field, dataType, operator, value: [..]}, isValidated: true}. Valid fields and data types come from segments.list_filterable_fields.",
        "example": {
          "or": [
            {
              "and": [
                {
                  "contact": {
                    "field": "email_blacklisted",
                    "dataType": "subscription_status",
                    "operator": "subscribed",
                    "value": [
                      "subscribed"
                    ]
                  },
                  "isValidated": true
                }
              ]
            }
          ]
        }
      },
      "page": {
        "type": "integer",
        "default": 1
      },
      "limit": {
        "type": "integer",
        "default": 20
      },
      "force_refresh": {
        "type": "boolean",
        "default": true
      }
    },
    "required": [
      "fe_query"
    ]
  },
  "outputs": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "email": {
                "type": "string"
              },
              "attributes": {
                "type": "object"
              },
              "entered": {
                "type": "string"
              },
              "last_modified": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "execution": {
    "method": "internal_api",
    "auth": "Cookie session of the logged-in app.brevo.com user, sent with the request (fetch credentials: include). No API key. Replayed from inside the app page only; behavior from outside a browser (CSRF, CORS, session expiry) was not tested.",
    "http": {
      "verb": "POST",
      "url": "https://contacts-api.brevo.com/contact/backend/segment/query",
      "body_template": {
        "fe_query": "{{fe_query}}",
        "page": "{{page}}",
        "limit": "{{limit}}",
        "force_refresh": "{{force_refresh}}"
      }
    }
  },
  "destructive": false,
  "reversible": true,
  "verification": {
    "level": "executed",
    "date": "2026-11-02",
    "evidence": "Own free account, 2026-11-02.",
    "notes": "Executed through the UI with request capture."
  }
}
